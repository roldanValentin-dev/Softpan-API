# Copiar este archivo como .env y completar los valores

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Base de datos PostgreSQL
DB_PASSWORD=Softpan123!

# JWT (generar una clave de al menos 32 caracteres)
JWT_KEY=MiClaveSuperSeguraDeAlMenos32Caracteres123
JWT_ISSUER=SoftpanAPI
JWT_AUDIENCE=SoftpanFrontend

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxx
MP_CLIENT_SECRET=xxxxxxxxxx
MP_BASE_URL=http://localhost:5173
MP_NOTIFICATION_URL=https://tu-dominio.ngrok-free.dev/api/mercadopago/webhook

# Puerto de la API (opcional, default: 7097)
API_PORT=7097

# Email (Gmail SMTP - gratis, 500 emails/día)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=softpan.pasteleria@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_NAME=Softpan

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=<tu-cloud-name>
CLOUDINARY_API_KEY=<tu-api-key>
CLOUDINARY_API_SECRET=<tu-api-secret>
